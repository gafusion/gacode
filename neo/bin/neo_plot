#!/bin/bash
#==============================================================================
# neo_plot
#
# PURPOSE:
#  Plotting routines for NEO output.
#==============================================================================

#==============================================================================
# Syntax validity check and help message
#
n=$#

if [ $n -eq 0 ]
then
  echo
  echo "Usage:    neo_plot [options]"
  echo
  echo "          -p <path>"
  echo "          Set optional path to simulation directory."
  echo "          [The default path is the current directory]"
  echo
  echo "          -e <simdir>"
  echo "          Use data in <simdir>."
  echo
  echo "          -ie <n>"
  echo "          Energy index (if applicable)"
  echo
  echo "          -is <list>"
  echo "          Species (1-based) for flux_th, e.g. 1 or 1,3 [default: all]"
  echo
  echo "          -moment <pflux|eflux|mflux|pflux_gv|eflux_gv|mflux_gv>"
  echo "          Moment for flux_th plot [default: pflux]"
  echo
  echo "          -norm"
  echo "          flux_th: divide by the GB value and by n_a/n_e (per-particle flux)"
  echo
  echo "          -plot <type>"
  echo "          Generate plot of given type."
  echo "          If this keyword is omitted, data will be listed to the screen."
  echo "           <type> = xtsurf"
  echo "                  = f3x (plots of pitch-angle dependence in 3D NEO)."
  echo "                  = flux_th (one moment, set by -moment, vs. theta for each species in one window,"
  echo "                              from out.neo.flux_theta; shows out.neo.transport and out.neo.transport_gv values)."
  echo
  echo "Example:"
  echo
  echo "   neo_plot -e . -plot xtsurf"
  echo "   neo_plot -e . -plot flux_th -is 1,2 -moment eflux -norm"

  exit 1
fi
#==============================================================================

#==============================================================================
# Define variables for flag capture
#
# Default simulation directory
LOCDIR=.
SIMROOT=$PWD
PLOT_TYPE=xtsurf
FTYPE=screen
IE=0
N=0
SPEC=all
MOMENT=pflux
NORM=0
#==============================================================================

#==============================================================================
# Parse command line options
#
while [ $# -gt 0 ] ; do
  case "$1" in

  -plot) shift ; PLOT_FLAG=1 ; PLOT_TYPE=$1 ;;

  -e) shift ; LOCDIR=$1 ;;

  -p) shift ; SIMROOT=$1 ;;

  -img) shift ; FTYPE=$1 ;;

  -ie) shift ; IE=$1 ;;

  -n) shift ; N=$1 ;;

  -is) shift ; SPEC=$1 ;;

  -moment) shift ; MOMENT=$1 ;;

  -norm) NORM=1 ;;

  *) echo "ERROR: incorrect neo_plot syntax." ; exit 1 ;;

  esac
  shift
done
#==============================================================================

if [ "$LOCDIR" == "." ]
then
   LOCDIR=`basename $PWD`
   cd .. ; SIMROOT=$PWD
fi
SIMDIR=$SIMROOT/$LOCDIR
cd $SIMDIR

#==============================================================================
case "$PLOT_TYPE" in

   xtsurf)
	python $GACODE_ROOT/neo/bin/neo_plot_xtsurf.py $SIMDIR $FTYPE  ;;

   f3x)
	python $GACODE_ROOT/neo/bin/neo_plot_f3x.py $FTYPE $IE $N $LOCDIR ;;

   flux_th)
	python $GACODE_ROOT/neo/bin/neo_plot_flux_th.py $SIMDIR $FTYPE $SPEC $MOMENT $NORM ;;

esac

exit 0
