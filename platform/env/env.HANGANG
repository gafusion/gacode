#!/usr/bin/env bash
# GACODE environment for KISTI-6 HANGANG (GH200 / ARM Grace)
# Cray programming environment: ftn wrapper + Cray MPICH (OpenMPI is NOT used)
#
# Why cray-mpich/9.0.1 + CUDA 12.9 (and not the default cray-mpich/9.1.0):
#   The compute-node NVIDIA driver is 570.x (CUDA 12.8). The GPU transport layer
#   (libmpi_gtl_cuda) of cray-mpich/9.1.0 needs libcudart.so.13, which this driver
#   cannot run ("CUDA driver version is insufficient for CUDA runtime version").
#   The GTL of cray-mpich/9.0.1 needs libcudart.so.12.
#   Override with: export MPICH_VER=<version>  /  export CUDA_MODULE=cuda/<version>_26.3
#   cray-libsci/25.09.0 is used with it (libsci 26.03.0 needs symbols only present in cray-mpich >= 9.1).
#   Override with: export LIBSCI_VER=<version>

# Prepend directories to LD_LIBRARY_PATH only if they are not already present
# (keeps the variable from growing every time this file is sourced).
_ld_prepend() {
    local new="" d
    local IFS=:
    for d in $1; do
        case ":${LD_LIBRARY_PATH}:" in
            *":${d}:"*) ;;
            *) new="${new:+${new}:}${d}" ;;
        esac
    done
    [ -n "${new}" ] && export LD_LIBRARY_PATH="${new}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
    return 0
}

module purge

module load craype-arm-grace
module load nvidia/26.3
module load craype/2.7.36
module load libfabric/2.3.1
module load craype-network-ofi
# cray-libsci/26.03.0 needs MPI_Comm_f2c/MPI_Comm_c2f from cray-mpich >= 9.1 (they are missing in
# libmpi_nvidia of cray-mpich/9.0.1), so an older libsci is used together with 9.0.1.
LIBSCI_VER="${LIBSCI_VER:-25.09.0}"
module load "cray-libsci/${LIBSCI_VER}"
module load PrgEnv-nvidia/8.7.0

# PrgEnv-nvidia loads the default cray-mpich (9.1.0). Switch to MPICH_VER.
# Do not load openmpi.
MPICH_VER="${MPICH_VER:-9.0.1}"
module unload cray-mpich
module load "cray-mpich/${MPICH_VER}"
if ! module -t list 2>&1 | grep -q "^cray-mpich/${MPICH_VER}"; then
    echo "env.HANGANG2: WARNING: cray-mpich/${MPICH_VER} is not loaded (check: module avail cray-mpich)" >&2
fi

# PrgEnv-nvidia may bring in its own (default) cray-libsci; make sure LIBSCI_VER is the one loaded.
if ! module -t list 2>&1 | grep -q "^cray-libsci/${LIBSCI_VER}"; then
    module unload cray-libsci
    module load "cray-libsci/${LIBSCI_VER}"
fi
if ! module -t list 2>&1 | grep -q "^cray-libsci/${LIBSCI_VER}"; then
    echo "env.HANGANG2: WARNING: cray-libsci/${LIBSCI_VER} is not loaded (check: module avail cray-libsci)" >&2
fi

# cray-mpich/9.0.1 links with -lpmi -lpmi2; these libraries come from the cray-pmi module
# (the default cray-mpich/9.1.0 did not need it, which is why it was not loaded before).
if ! module -t list 2>&1 | grep -q '^cray-pmi'; then
    module load cray-pmi
fi
if ! module -t list 2>&1 | grep -q '^cray-pmi'; then
    echo "env.HANGANG2: WARNING: cray-pmi is not loaded (check: module avail cray-pmi)" >&2
fi

# CUDA toolkit (must be loaded BEFORE craype-accel-*: the accel modulefile fails with a
# Tcl error otherwise). The module also sets CUDA_HOME and NVHPC_CUDA_HOME.
CUDA_MODULE="${CUDA_MODULE:-cuda/12.9_26.3}"
module load "${CUDA_MODULE}"
CUDA_VER="${CUDA_MODULE#cuda/}"
export CUDA_VER="${CUDA_VER%%_*}"

# GPU-aware Cray MPICH needs a craype-accel module loaded at BUILD time so that the
# GPU transport layer (libmpi_gtl_cuda) is linked.
ACCEL_MODULE="${ACCEL_MODULE:-craype-accel-nvidia90}"
module load "${ACCEL_MODULE}"
if ! module -t list 2>&1 | grep -q "^${ACCEL_MODULE}"; then
    echo "env.HANGANG2: WARNING: ${ACCEL_MODULE} is not loaded (check: module avail craype-accel)" >&2
fi

# NetCDF requires HDF5. Load HDF5 before NetCDF.
module load cray-hdf5/1.14.3.9
module load cray-netcdf/4.9.2.3
module load cray-fftw/3.3.10.11

# Explicit, module-derived locations.
export NETCDF_DIR="${CRAY_NETCDF_PREFIX}"
export HDF5_DIR="${CRAY_HDF5_PREFIX}"
export LIBSCI_DIR="${CRAY_LIBSCI_PREFIX_DIR}"

# Embed library paths in executables built with the Cray wrappers.
export CRAY_ADD_RPATH=yes

# The CPE modules populate CRAY_LD_LIBRARY_PATH. Add those shared-library
# directories to the runtime search path.
if [ -n "${CRAY_LD_LIBRARY_PATH:-}" ]; then
    _ld_prepend "${CRAY_LD_LIBRARY_PATH}"
fi
